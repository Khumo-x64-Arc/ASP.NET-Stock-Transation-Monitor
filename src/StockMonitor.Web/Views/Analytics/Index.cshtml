<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="page-title">Analytics</h1>
        <div class="page-sub">Cash flows, income, gains and costs from the warehouse views. Refreshes automatically as transactions arrive.</div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <select id="f-account" class="form-select form-select-sm" style="width:auto"></select>
        <input id="f-from" type="month" class="form-control form-control-sm" style="width:auto" value="2020-04" />
        <span class="text-secondary">to</span>
        <input id="f-to" type="month" class="form-control form-control-sm" style="width:auto" />
        <button id="f-apply" class="btn btn-sm btn-ghost"><i class="bi bi-funnel"></i> Apply</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-8"><div class="card-s"><h6>Monthly cash flows</h6><div class="chart-box lg"><canvas id="flowChart"></canvas></div></div></div>
    <div class="col-xl-4"><div class="card-s"><h6>Net contributions vs net invested</h6><div class="chart-box lg"><canvas id="cumChart"></canvas></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-7"><div class="card-s"><h6>Dividend income by month <span class="text-secondary text-lowercase fw-normal" id="div-total"></span></h6><div class="chart-box"><canvas id="divChart"></canvas></div></div></div>
    <div class="col-xl-5"><div class="card-s"><h6>Top dividend payers</h6><div class="chart-box"><canvas id="payerChart"></canvas></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-5">
        <div class="card-s">
            <h6>Realised gains by UK tax year <span class="text-secondary text-lowercase fw-normal">S104 average cost</span></h6>
            <div class="chart-box sm"><canvas id="realChart"></canvas></div>
            <table class="table table-s table-sm mt-3"><thead><tr><th>Tax year</th><th>Acct</th><th class="num">Disposals</th><th class="num">Proceeds</th><th class="num">Gain</th><th class="num" title="Broker 'Result' column">Broker</th></tr></thead><tbody id="realTable"></tbody></table>
        </div>
    </div>
    <div class="col-xl-4"><div class="card-s"><h6>ISA allowance used <span class="text-secondary text-lowercase fw-normal">£20k / tax year</span></h6><div class="chart-box"><canvas id="isaChart"></canvas></div>
        <div class="small text-secondary mt-2">Deposits above 100% usually indicate transfers-in from another ISA, which do not use allowance.</div></div></div>
    <div class="col-xl-3"><div class="card-s"><h6>Activity mix</h6><div class="chart-box"><canvas id="mixChart"></canvas></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-4">
        <div class="card-s">
            <h6>Costs of investing</h6>
            <table class="table table-s table-sm"><tbody id="feesTable"></tbody></table>
            <h6 class="mt-3">Withholding tax on dividends</h6>
            <table class="table table-s table-sm"><thead><tr><th>Year</th><th>Ccy</th><th class="num">Withheld</th></tr></thead><tbody id="whtTable"></tbody></table>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card-s">
            <h6>Pipeline &amp; data quality <span class="text-secondary text-lowercase fw-normal" id="pipe-meta"></span></h6>
            <div class="table-responsive">
                <table class="table table-s table-sm"><thead><tr><th>Batch</th><th>Type</th><th>Started</th><th>Status</th><th class="num">Extracted</th><th class="num">Cleansed</th><th class="num">Rejected</th><th class="num">Loaded</th><th class="num">Queued</th><th class="num">Warn</th></tr></thead><tbody id="batchTable"></tbody></table>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-5"><table class="table table-s table-sm"><thead><tr><th>Rule</th><th>Sev</th><th class="num">Rows</th></tr></thead><tbody id="ruleTable"></tbody></table></div>
                <div class="col-md-7"><div class="scroll-y" style="max-height:260px"><table class="table table-s table-sm"><thead><tr><th>Rule</th><th>Where</th><th>Detail</th></tr></thead><tbody id="issueTable"></tbody></table></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <script src="~/js/analytics.js" asp-append-version="true"></script> }
