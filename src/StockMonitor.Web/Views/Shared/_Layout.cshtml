<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · StockMonitor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@{ var nav = ViewData["Nav"] as string; }
<nav class="navbar navbar-expand-md app-nav sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <span class="brand-mark"><i class="bi bi-activity"></i></span>
            <span class="fw-semibold">StockMonitor</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto gap-md-1">
                <li class="nav-item"><a class="nav-link @(nav == "dashboard" ? "active" : "")" href="/"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                <li class="nav-item"><a class="nav-link @(nav == "analytics" ? "active" : "")" href="/analytics"><i class="bi bi-bar-chart-line me-1"></i>Analytics</a></li>
                <li class="nav-item"><a class="nav-link @(nav == "portfolio" ? "active" : "")" href="/portfolio"><i class="bi bi-briefcase me-1"></i>Portfolio</a></li>
            </ul>
            <span id="conn-status" class="conn-pill conn-connecting"><span class="dot"></span><span class="label">Connecting</span></span>
        </div>
    </div>
</nav>
<div class="ticker-tape"><div id="ticker-track" class="ticker-track"><span class="text-secondary px-3">Waiting for prices…</span></div></div>

<main class="container-fluid px-4 py-4">
    @RenderBody()
</main>

<footer class="container-fluid px-4 pb-4 small text-secondary">
    Prices are simulated (GBM around last traded price) unless a market-data provider is configured. Values in GBP.
</footer>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toasts"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="~/js/common.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
